ypred_lin = predict(mdl_lin, X2_test); 

% Calculate model accuracy by comparing predicted test labels against actual target values
acc_lin = mean(ypred_lin == Ytest); 

% Compute the confusion matrix for the linear SVM model predictions
cm_lin = confusionmat(Ytest, ypred_lin); 

% Print the overall classification accuracy percentage to the console window
fprintf("Accuracy: %.2f%%\n", acc_lin * 100); 

% Display header text for the confusion matrix output
disp("Confusion Matrix:"); 

% Output the computed confusion matrix values to the console window
disp(cm_lin); 

% Initialize a figure window to render model decision boundary plots
figure(); 

% Create the first subplot area for the Linear SVM visualization
subplot(1, 3, 1); 

% Call custom function to render linear kernel decision boundary and test data
plotKernelSimple(mdl_lin, x1g, x2g, gridX, X2_test, Ytest, Fnames, 'Linear Kernel'); 

