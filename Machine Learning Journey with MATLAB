for ep = 1:episodes
    state = 1; % Reset agent to the starting state (state 1)
    totalReward = 0; % Initialize total accumulated reward for the episode
    
    % Loop until the agent reaches the goal state
    while state ~= goalState
        % Epsilon-greedy action selection strategy
        if rand < epsilon
            action = randi(nActions); % Explore: pick a random action
        else
            [~, action] = max(Q(state, :)); % Exploit: pick the action with highest Q-value
        end
        
        % Environment transition dynamics based on selected action
        if action == 1
            newState = max(1, state - 1); % Move left (bound at minimum state 1)
        else
            newState = min(nStates, state + 1); % Move right (bound at maximum state 10)
        end
        
        % Calculate immediate reward (+10 for reaching goal, -1 for step penalty)
        reward = (newState == goalState) * 10 - 1; 
        totalReward = totalReward + reward; % Accumulate total reward
        
        % Update Q-table using the Bellman equation
        Q(state, action) = Q(state, action) + alpha * (reward + gamma * max(Q(newState, :)) - Q(state, action)); 
        
        % Transition agent to the next state
        state = newState; 
    end
    
    % Store total reward achieved in the current episode
    rewards_history(ep) = totalReward; 
end

% Display the final learned Q-table
disp('Q Table:'); 
disp(round(Q, 2)); 

