path = state; % Initialize path tracker
while state ~= goalState
    [~, action] = max(Q(state, :)); % Select optimal greedy action
    if action == 1
        state = max(1, state - 1); % Apply left action
    else
        state = min(nStates, state + 1); % Apply right action
    end
    
    path(end+1) = state; % Append updated state to path vector
    if numel(path) > 50, break; end % Safety guard to avoid infinite loops
end

