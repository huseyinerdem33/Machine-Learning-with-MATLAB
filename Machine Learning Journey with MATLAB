% Define function to plot decision boundaries and test data distribution
function plotKernelSimple(mdl, x1g, x2g, gridX, Xtest, Ytest, fname, titleText)
    % Compute decision scores on grid points to determine boundary contours
    [~, score] = predict(mdl, gridX); 
    
    % Reshape score array into grid dimensions matching meshgrid coordinates
    S = reshape(score(:,2), size(x1g)); 
    
    % Plot filled contour background to visually demonstrate decision regions
    contourf(x1g, x2g, S, 20, 'LineStyle', 'none', 'FaceAlpha', 0.15); 
    
    % Apply standard colormap palette to background contour regions
    colormap("parula"); 
    
    % Retain current plot axes to layer additional decision boundaries
    hold on; 
    
    % Draw boundary line where score equals zero to mark decision limit
    contour(x1g, x2g, S, [0, 0], 'r', 'LineWidth', 2.5); 

    % Display test sample data points categorized by class markers
    gscatter(Xtest.(fname{1}), Xtest.(fname{2}), Ytest, [1 0 0; 0 0.7 0], 'ox', 8, 'off'); 

    % Set descriptive label for horizontal X axis
    xlabel(fname{1}); 
    
    % Set descriptive label for vertical Y axis
    ylabel(fname{2}); 

    % Display subplot header text title
    title(titleText); 
    
    % Enable background grid lines for visual reference
    grid on; 
    
    % Release plot retention lock on axes
    hold off; 
end

