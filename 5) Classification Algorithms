YTrain = Y_categorical(cv.training, :);

% Extract testing features and categorical ground-truth labels
XTest = X(cv.test, :);
YTest = Y_categorical(cv.test, :);


%% 3. Model 1: Full / Unconstrained Complex Tree (Prone to Overfitting)
% Train a standard unconstrained classification tree
complex_tree = fitctree(XTrain, YTrain);

% Predict labels on unseen test data using the complex model
predictions1 = predict(complex_tree, XTest);

% Calculate accuracy of the complex model on the test dataset
accuracy1 = mean(predictions1 == YTest);
fprintf('Test Accuracy of Complex Tree: %.4f\n', accuracy1);

% Calculate tree complexity (total leaf nodes count)
leaf_count1 = sum(complex_tree.IsBranchNode == 0);
fprintf('Leaf Count in Complex Tree: %d\n', leaf_count1);


%% 4. Model 2: Pruned / Simplified Tree (Prevents Overfitting)
% Train a constrained tree setting 'MinLeafSize' to 15 to prevent overfitting
simple_tree = fitctree(XTrain, YTrain, 'MinLeafSize', 15);

% Predict labels on unseen test data using the pruned model
predictions2 = predict(simple_tree, XTest);

% Calculate accuracy of the pruned model on the test dataset
accuracy2 = mean(predictions2 == YTest);
fprintf('Test Accuracy of Pruned Tree: %.4f\n', accuracy2);

% Calculate pruned tree complexity (total leaf nodes count)
leaf_count2 = sum(simple_tree.IsBranchNode == 0);
fprintf('Leaf Count in Pruned Tree: %d\n', leaf_count2);


