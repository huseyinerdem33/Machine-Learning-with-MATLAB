% Extract numerical features starting from column 3 into an array
X = table2array(data(:, 3:end)); 

% Normalize features to have zero mean and unit variance
X_norm = normalize(X); 

% Perform Principal Component Analysis (PCA) on normalized data
[coeff, score, ~, ~, explained] = pca(X_norm); 

% Select the first two principal components for visualization and clustering
X_pca = score(:, 1:2); 

% Display the cumulative percentage of variance explained by the first 2 components
fprintf('Variance explained by PCA: %.2f%%\n', sum(explained(1:2))); 

% Define the maximum number of clusters to test
maxK = 5; 

% Pre-allocate vector to store mean silhouette values
sil = zeros(maxK, 1); 

% Iterate over cluster counts from 2 to maxK
for k = 2:maxK 
    % Run K-Means clustering with 10 replicates to avoid local minima
    idx = kmeans(X_pca, k, 'Replicates', 10); 
    
    % Calculate the mean silhouette score for current cluster size
    sil(k) = mean(silhouette(X_pca, idx)); 
end 

% Identify the optimal number of clusters and the highest silhouette score
[bestSil, bestK] = max(sil); 

% Display the optimal number of clusters along with its silhouette score
fprintf('Optimal number of clusters: %d | Silhouette Score: %.4f\n', bestK, bestSil); 

% Perform final K-Means clustering using the optimal number of clusters
[idx, C] = kmeans(X_pca, bestK, 'Replicates', 10); 

% Create a new figure window for visualization
