% =========================================================================

% Construct input table row for inference
new_opamp = table(val_Gain, val_Rin, val_Rout, val_GBW, val_Offset, val_Bias, val_CMRR, val_PSRR, val_SR, ...
    'VariableNames', X.Properties.VariableNames); % Map table column headers to match features

% Perform prediction
predicted_deviation = predict(model, new_opamp); % Predict deviation score
ideality_percentage = max(0, 100 - predicted_deviation); % Compute percentage of ideality

% Print prediction output to console
fprintf('===================================================\n'); % Header line
fprintf('           NEW OP-AMP PREDICTION RESULTS           \n'); % Title
fprintf('===================================================\n'); % Header line
fprintf('Predicted Ideality Deviation Score : %.2f / 100\n', predicted_deviation); % Output predicted score
fprintf('Overall Design Ideality Level      : %.2f%%\n', ideality_percentage); % Output percentage
fprintf('===================================================\n'); % Footer line

